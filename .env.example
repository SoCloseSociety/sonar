# ╔═══════════════════════════════════════════╗
# ║  SONAR — Environment Configuration       ║
# ║  Copy this file to .env and fill in      ║
# ╚═══════════════════════════════════════════╝

# === APPLICATION ===
APP_NAME=SONAR
APP_ENV=development                      # development | production
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM     # openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM     # openssl rand -hex 32
ADMIN_USERNAME=admin

# === DATABASE ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sonar
POSTGRES_USER=sonar
POSTGRES_PASSWORD=CHANGE_ME              # Strong password for production!

# === REDIS ===
REDIS_HOST=redis
REDIS_PORT=6379

# === OLLAMA (local LLM) ===
# Mac dev: http://host.docker.internal:11434
# Server:  http://localhost:11434  (or remote Ollama URL)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b                 # Must be pulled: ollama pull llama3.2:3b

# === TELEGRAM BOT (optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# === FLIGHT TRACKING ===
# OpenSky: free account at https://opensky-network.org/register
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
ADSB_EXCHANGE_API_KEY=

# === VESSEL TRACKING ===
# AISStream: free API key at https://aisstream.io
AISSTREAM_API_KEY=

# === NASA FIRMS (fire detection) ===
# Free key: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_MAP_KEY=

# === WEBCAMS ===
# Windy free key: https://api.windy.com
WINDY_WEBCAMS_API_KEY=

# === TWITTER (optional) ===
TWITTER_BEARER_TOKEN=

# === YOUTUBE (optional) ===
YOUTUBE_API_KEY=

# === ACLED (Armed Conflict — free) ===
# Register: https://acleddata.com/register
ACLED_API_KEY=
ACLED_EMAIL=

# === SHODAN (optional) ===
# https://account.shodan.io
SHODAN_API_KEY=

# === THRESHOLDS ===
# These are overridden by docker-compose environment vars
SCAN_INTERVAL_SECONDS=120
ALERT_MIN_SEVERITY=6
SIGNAL_MIN_CONFIDENCE=0.70
MISPRICING_MIN_PCT=10
TENSION_UPDATE_INTERVAL=300
FLIGHT_SCAN_INTERVAL=60
VESSEL_SCAN_INTERVAL=120
